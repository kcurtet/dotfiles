#!/usr/bin/env bash
# theme — switch the whole terminal stack between day (light) and night (dark).
#
# Synchronizes in one shot:
#   1. alacritty  -> rewrites theme-current.toml (live_config_reload applies to
#                    every open window instantly)
#   2. herdr      -> sets theme.name in config.toml + live-reloads the server
#   3. pi         -> sets "theme" in ~/.pi/agent/settings.json (new sessions)
#   4. nvim       -> writes ~/.config/terminal-theme (chadrc reads it at
#                    startup; running instances live-switch on FocusGained)
#
# Usage: theme {day|night|toggle|status}

set -euo pipefail

STATE_FILE="$HOME/.config/terminal-theme"
ALAC_CURRENT="$HOME/.config/alacritty/theme-current.toml"
HERDR_CONFIG="$HOME/.config/herdr/config.toml"
PI_SETTINGS="$HOME/.pi/agent/settings.json"

# NOTE: keep the pairs coherent — alacritty file | herdr theme | nvim theme
NIGHT_ALAC="$HOME/.config/alacritty/theme-nord.toml"
NIGHT_HERDR="nord"
NIGHT_PI="nord"
NIGHT_BAT="Nord"
DAY_ALAC="$HOME/.config/alacritty/theme-nord-light.toml"
DAY_HERDR="catppuccin-latte"
DAY_PI="nord-light"
DAY_BAT="OneHalfLight"
BAT_CONFIG="$HOME/.config/bat/config"

current() {
  if [[ -f "$STATE_FILE" ]]; then cat "$STATE_FILE"; else echo dark; fi
}

set_theme() { # $1 = light | dark
  local mode="$1" alac herdr pi bat
  if [[ "$mode" == "light" ]]; then
    alac="$DAY_ALAC"; herdr="$DAY_HERDR"; pi="$DAY_PI"; bat="$DAY_BAT"
  else
    alac="$NIGHT_ALAC"; herdr="$NIGHT_HERDR"; pi="$NIGHT_PI"; bat="$NIGHT_BAT"
  fi

  # 1. alacritty: swap the palette file atomically, then touch the main config
  #    (always watched) so the full import tree is re-resolved on every switch
  cp "$alac" "$ALAC_CURRENT.tmp" && mv "$ALAC_CURRENT.tmp" "$ALAC_CURRENT"
  touch "$HOME/.config/alacritty/alacritty.toml"

  # 2. herdr: point theme.name at the right theme and reload the running server
  if [[ -f "$HERDR_CONFIG" ]]; then
    sed -i "s/^name = \".*\"/name = \"$herdr\"/" "$HERDR_CONFIG"
    herdr server reload-config >/dev/null 2>&1 || true
  fi

  # 3. pi: theme for new sessions
  if [[ -f "$PI_SETTINGS" ]] && command -v jq >/dev/null; then
    local tmp="$PI_SETTINGS.tmp"
    jq --arg t "$pi" '.theme = $t' "$PI_SETTINGS" > "$tmp" && mv "$tmp" "$PI_SETTINGS"
  fi

  # 4. nvim: state file (startup via chadrc + live via FocusGained autocmd)
  printf '%s\n' "$mode" > "$STATE_FILE"

  # 5. git-delta: switch the delta feature (every new git diff picks it up)
  command -v git >/dev/null && git config --global delta.features "$([ "$mode" == light ] && echo day || echo night)"

  # 6. bat: swap the theme line (bat reads its config on every run)
  if [[ -f "$BAT_CONFIG" ]]; then
    sed -i "s/^--theme=.*/--theme=\"$bat\"/" "$BAT_CONFIG"
  fi
}

case "${1:-toggle}" in
  day|light)   set_theme light ;;
  night|dark)  set_theme dark ;;
  toggle)
    if [[ "$(current)" == "light" ]]; then set_theme dark; else set_theme light; fi
    ;;
  status)
    echo "current: $(current)"
    exit 0
    ;;
  *)
    echo "usage: theme {day|night|toggle|status}" >&2
    exit 1
    ;;
esac

echo "theme → $(cat "$STATE_FILE") (alacritty: live · herdr: live · nvim: focus/startup · pi/delta/bat: próximas invocaciones)"
